<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The build-time half of JsxCore, invoked by the MSBuild targets.

    The JsxCore package embeds this project's publish output under tools/, so anything needing real
    parsing, probing or JSON construction is C# with tests behind it rather than property functions
    and regular expressions in a .targets file.

    Not packed on its own. The command line npm client that used to be packed from here is
    JsxCore.Npm, which references JsxCore.PackageManagement and not this: a tool a person installs
    to add a package has no use for a view engine, and shipped one until they were separated.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JsxCore.Tool</AssemblyName>
    <RootNamespace>JsxCore.Tool</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Targets net8.0 so it runs on every framework JsxCore supports. The MSBuild targets set a roll
      forward policy on the command line, and this covers anyone invoking it directly.
    -->
    <RollForward>Major</RollForward>

    <!-- Invoked as "dotnet exec", so the native launcher and symbols are dead weight in the package. -->
    <UseAppHost>false</UseAppHost>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      The two properties above only speak for this assembly. JsxCore is referenced, and a reference
      brings its .pdb and its .xml along with it, so the publish output picked up both: a third of
      a megabyte of IntelliSense documentation and symbols sitting beside an executable that is
      never opened in an editor and, per DebugType above, already carries no symbols of its own.
      Debugging the library is what the symbol package is for.
    -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsxCore\JsxCore.csproj" />

    <!--
      Named as well as JsxCore, which references it privately so that it does not become a package
      dependency. That stops it flowing transitively here too, and provision needs it directly.
      Consumers of the package are unaffected: the assembly sits in lib/ and is referenced with
      everything else there.
    -->
    <ProjectReference Include="..\JsxCore.PackageManagement\JsxCore.PackageManagement.csproj" />
  </ItemGroup>

</Project>
