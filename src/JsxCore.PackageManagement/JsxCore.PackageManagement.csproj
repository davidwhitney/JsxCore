<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The npm client, on its own.

    Resolving versions, verifying integrity, unpacking tarballs and writing a lock file have nothing
    to do with rendering a view, and this assembly proves it: no Jint, no ASP.NET Core, nothing but
    the BCL. That is the point. JsxCore.Npm is a command line npm client, and before this split it
    could not be delivered as one, because referencing the view engine to reach the package client
    dragged a JavaScript interpreter and a framework reference along with it.

    Both deliveries reference this, so a package added by "dotnet npm add" and a package restored by
    a build still go through one implementation.

    It is not published as its own package. It is built into JsxCore's lib folders alongside
    JsxCore.dll, and bundled into JsxCore.Npm as a loose assembly the way any tool dependency is, so
    nothing new appears in a consumer's dependency tree.

    Namespaces are unchanged by the move. The project directory stands in for the
    JsxCore.Compilation.Provisioning.PackageManagement prefix rather than repeating it four levels
    deep on disk, and Modules/ holds the two types under JsxCore.Compilation.Modules that the client
    needs and the view engine shares.

    Shared/ is the rest of that: ToolProcess, which runs an external program with a timeout and is
    as useful to tsc and esbuild as it is to npm, and the base JsxCoreException. Being the lower of
    the two assemblies, this is where anything both of them need has to live.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>JsxCore.Compilation.Provisioning.PackageManagement</RootNamespace>
    <AssemblyName>JsxCore.PackageManagement</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JsxCore.Tests" />
  </ItemGroup>

</Project>
