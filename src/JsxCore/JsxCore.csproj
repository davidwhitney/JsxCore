<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>JsxCore</RootNamespace>
    <AssemblyName>JsxCore</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Documentation is for members where it adds something, not a checklist to satisfy.
      CS1591 is missing documentation; CS1573 is documenting some parameters of a member but not
      the ones whose names already say everything.
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>JsxCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>David Whitney</Authors>
    <Title>JsxCore: a TSX/JSX view engine for ASP.NET Core</Title>
    <Description>A TSX/JSX view engine for ASP.NET Core. Write views as .tsx or .jsx files and return them from controllers or minimal APIs. Compiled by the native TypeScript compiler and served as native ES modules with no bundler, rendered on the client, on the server, or both. Includes synchronous .NET interop from server-rendered views, TypeScript types generated from your .NET models, and hot reload in development.</Description>
    <PackageTags>aspnetcore;mvc;view-engine;tsx;jsx;typescript;preact;ssr;hydration;hmr;esm</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/davidwhitney/JsxCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/davidwhitney/JsxCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The runtime and the shared tsconfig base are embedded in the assembly, so they never appear as
    files in a consuming project. Runtime JavaScript is served to the browser and loaded by the
    server-side renderer straight from these resources.
  -->
  <ItemGroup Label="Embedded assets">
    <EmbeddedResource Include="Assets\**\*.js;Assets\**\*.json;Assets\**\*.ts" />
    <None Remove="Assets\**\*.js;Assets\**\*.json;Assets\**\*.ts" />
  </ItemGroup>

  <!--
    The MSBuild target compiles views during `dotnet build` and `dotnet publish`. It runs in a
    separate process from the library, so it needs the tsconfig base and the runtime type
    declarations as real files. They are packed from the same source folder as the embedded copies,
    so the two can never drift.
  -->
  <ItemGroup Label="Build-time compilation">
    <None Include="build\JsxCore.targets" Pack="true" PackagePath="buildTransitive\JsxCore.targets" />
    <None Include="Assets\tsconfig.base.json" Pack="true" PackagePath="buildTransitive\tsconfig.base.json" />
    <None Include="Assets\runtime\*.d.ts" Pack="true" PackagePath="buildTransitive/runtime/" />
    <None Include="Assets\runtime\package.json" Pack="true" PackagePath="buildTransitive/runtime/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />

    <!-- Packed as icon.png so <PackageIcon> can name it without depending on the source file name. -->
    <None Include="..\..\images\jsxcore-nuget-icon-128.png" Pack="true" PackagePath="icon.png"
          Visible="false" Condition="Exists('..\..\images\jsxcore-nuget-icon-128.png')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JsxCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.15.1" />
  </ItemGroup>

  <!--
    The build tool ships in the package and is invoked by JsxCore.targets. It cannot be a
    ProjectReference: it references this project, so the reference would be circular. It is built
    as a process instead, and its published output is collected just before the nuspec is written.
  -->
  <Target Name="JsxCorePackAnalyzer" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_JsxCoreAnalyzerProject>$(MSBuildThisFileDirectory)../JsxCore.Analyzers/JsxCore.Analyzers.csproj</_JsxCoreAnalyzerProject>
      <_JsxCoreAnalyzerOutput>$(MSBuildThisFileDirectory)../JsxCore.Analyzers/bin/$(Configuration)/netstandard2.0/</_JsxCoreAnalyzerOutput>
    </PropertyGroup>

    <Exec Command="dotnet build &quot;$(_JsxCoreAnalyzerProject)&quot; -c $(Configuration) --nologo -v quiet" />

    <ItemGroup>
      <_PackageFiles Include="$(_JsxCoreAnalyzerOutput)JsxCore.Analyzers.dll">
        <PackagePath>analyzers/dotnet/cs/</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
    </ItemGroup>
  </Target>

  <Target Name="JsxCorePackBuildTool" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_JsxCoreToolProject>$(MSBuildThisFileDirectory)../JsxCore.Tool/JsxCore.Tool.csproj</_JsxCoreToolProject>
      <_JsxCoreToolOutput>$(MSBuildThisFileDirectory)../JsxCore.Tool/bin/$(Configuration)/publish-for-pack/</_JsxCoreToolOutput>
    </PropertyGroup>

    <!-- Published rather than built, so every assembly it needs sits beside it in the package. -->
    <Exec Command="dotnet publish &quot;$(_JsxCoreToolProject)&quot; -c $(Configuration) -o &quot;$(_JsxCoreToolOutput)&quot; --nologo -v quiet" />

    <ItemGroup>
      <_JsxCoreToolFile Include="$(_JsxCoreToolOutput)**/*" />
      <_PackageFiles Include="@(_JsxCoreToolFile)">
        <PackagePath>tools/net8.0/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
    </ItemGroup>
  </Target>

</Project>
