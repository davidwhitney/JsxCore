<Project>

  <!--
    Build-time compilation of JSX/TSX views.

    Views are compiled by the native TypeScript compiler as part of `dotnet build` and
    `dotnet publish`, and the emitted JavaScript is carried into the publish output. A published
    application therefore contains everything it needs to render and can run with
    JsxCoreOptions.PrecompiledOnly set, with no TypeScript toolchain installed on the server.

    Set <JsxCoreCompileOnBuild>false</JsxCoreCompileOnBuild> to opt out and rely on the view
    engine's own startup compilation instead.
  -->

  <PropertyGroup>
    <JsxCoreCompileOnBuild Condition="'$(JsxCoreCompileOnBuild)' == ''">true</JsxCoreCompileOnBuild>
    <JsxCoreViewsDirectory Condition="'$(JsxCoreViewsDirectory)' == ''">Views</JsxCoreViewsDirectory>
    <JsxCoreWorkingDirectory Condition="'$(JsxCoreWorkingDirectory)' == ''">$(BaseIntermediateOutputPath)JsxCore\</JsxCoreWorkingDirectory>

    <!--
      Directory arguments are passed to the tool with their trailing separator stripped. On Windows
      a quoted argument that ends in a backslash reads as an escaped quote, so "obj\JsxCore\" does
      not terminate: it swallows the rest of the command line and every argument after it is lost.
      The tool joins paths, so whether one ends in a separator makes no difference to it.
    -->
    <_JsxCoreWorkingArg>$(JsxCoreWorkingDirectory.TrimEnd('\').TrimEnd('/'))</_JsxCoreWorkingArg>
    <_JsxCoreViewsArg>$(JsxCoreViewsDirectory.TrimEnd('\').TrimEnd('/'))</_JsxCoreViewsArg>

    <!-- error | warn | off -->
    <JsxCoreTypeChecking Condition="'$(JsxCoreTypeChecking)' == ''">warn</JsxCoreTypeChecking>

    <!--
      Optional: preact (the default) or react. Views are compiled against this framework's JSX
      factory, and elements built by one cannot be rendered by the other, so the build stamps the
      choice onto the assembly for the application to read back.
    -->

    <!--
      Minify what is served, and compress it on the way out. Both default to Release only: they
      cost build time and obscure the source, which is the wrong trade while developing.

      Minification needs esbuild, restored alongside the compiler when this is on. Both settings
      are stamped onto the assembly below, so turning one off here also turns it off for an
      application that compiles at startup.
    -->
    <JsxCoreMinify Condition="'$(JsxCoreMinify)' == '' And '$(Configuration)' == 'Release'">true</JsxCoreMinify>
    <JsxCoreMinify Condition="'$(JsxCoreMinify)' == ''">false</JsxCoreMinify>

    <JsxCoreCompressAssets Condition="'$(JsxCoreCompressAssets)' == '' And '$(Configuration)' == 'Release'">true</JsxCoreCompressAssets>
    <JsxCoreCompressAssets Condition="'$(JsxCoreCompressAssets)' == ''">false</JsxCoreCompressAssets>

    <!--
      A Release build compiles the views and carries them into the output, so the application can
      serve what the build produced instead of compiling again on a server that may have no
      toolchain. Debug leaves it off, because compiling at startup is what makes a view change
      show up without a rebuild.

      Stamped onto the assembly below, so an application started from published output obeys it
      without anyone writing PrecompiledOnly in Program.cs.
    -->
    <JsxCorePrecompiled Condition="'$(JsxCorePrecompiled)' == '' And '$(Configuration)' == 'Release' And '$(JsxCoreCompileOnBuild)' != 'false'">true</JsxCorePrecompiled>
    <JsxCorePrecompiled Condition="'$(JsxCorePrecompiled)' == ''">false</JsxCorePrecompiled>

    <!--
      Install missing npm packages as part of the build. This is what makes a clean checkout work:
      without it the compiler is absent, nothing is compiled, and the failure only surfaces later.
    -->
    <JsxCoreAutoInstallDependencies Condition="'$(JsxCoreAutoInstallDependencies)' == ''">true</JsxCoreAutoInstallDependencies>
    <JsxCoreGenerateEditorTsConfig Condition="'$(JsxCoreGenerateEditorTsConfig)' == ''">true</JsxCoreGenerateEditorTsConfig>

    <!-- Left empty so the tool probes for npm itself, including the .cmd wrapper on Windows. -->
    <JsxCoreNpm Condition="'$(JsxCoreNpm)' == ''"></JsxCoreNpm>

    <!--
      Which package manager restores packages. Empty takes the first that can run, which is the
      native client: it talks to the registry directly and needs no Node installed. Set this to
      npm to run the npm on the machine instead.
    -->
    <JsxCorePackageManager Condition="'$(JsxCoreUseNpm)' == 'true'">npm</JsxCorePackageManager>
    <JsxCorePackageManager Condition="'$(JsxCorePackageManager)' == ''"></JsxCorePackageManager>

    <!-- Overridable so the repository's own sample can import these targets from source, where the
         asset files sit outside the build folder they are packed into. -->
    <JsxCoreToolsDirectory Condition="'$(JsxCoreToolsDirectory)' == ''">$(MSBuildThisFileDirectory)</JsxCoreToolsDirectory>
  </PropertyGroup>

  <!--
    Settings the view location generator reads.

    It emits the assembly annotations that let an IDE resolve a View() call returning a .tsx file,
    which it cannot do by itself because it looks for Razor. A generator rather than a written file,
    so the annotations reach the compilation an editor is already running and views resolve without
    a build first.

    The attribute definitions are skipped when the project references JetBrains.Annotations, which
    already has them.
  -->
  <PropertyGroup>
    <JsxCoreEmitViewLocationAnnotations Condition="'$(JsxCoreEmitViewLocationAnnotations)' == ''">true</JsxCoreEmitViewLocationAnnotations>
    <JsxCoreViewExtensions Condition="'$(JsxCoreViewExtensions)' == ''">.tsx;.jsx</JsxCoreViewExtensions>
  </PropertyGroup>

  <Target Name="JsxCoreDetectAnnotationsPackage" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_JsxCoreAnnotationsPackage Include="@(PackageReference)" Condition="'%(Identity)' == 'JetBrains.Annotations'" />
    </ItemGroup>

    <PropertyGroup>
      <JsxCoreDefinesAnnotationAttributes Condition="'@(_JsxCoreAnnotationsPackage)' != ''">false</JsxCoreDefinesAnnotationAttributes>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <CompilerVisibleProperty Include="JsxCoreEmitViewLocationAnnotations" />
    <CompilerVisibleProperty Include="JsxCoreViewsDirectory" />
    <CompilerVisibleProperty Include="JsxCoreViewExtensions" />
    <CompilerVisibleProperty Include="JsxCoreViewLocationFormats" />
    <CompilerVisibleProperty Include="JsxCoreAreaViewLocationFormats" />
    <CompilerVisibleProperty Include="JsxCoreDefinesAnnotationAttributes" />
  </ItemGroup>

  <!--
    Build logic that needs real parsing, probing or JSON construction lives in JsxCore.Tool and is
    invoked from here. Locating node_modules, reading package.json and writing the compiler
    configuration are all things a .targets file can only approximate, and the approximations had
    drifted from the C# that does the same jobs at run time. The targets now decide when things
    happen; the tool decides what the answers are.

    Roll-forward is set so the tool runs on whatever shared runtime the machine has, rather than
    requiring the exact one it was built against.
  -->
  <PropertyGroup>
    <JsxCoreToolPath Condition="'$(JsxCoreToolPath)' == ''">$(MSBuildThisFileDirectory)../tools/net8.0/JsxCore.Tool.dll</JsxCoreToolPath>
    <JsxCoreToolCommand Condition="'$(JsxCoreToolCommand)' == ''">dotnet exec --roll-forward Major &quot;$(JsxCoreToolPath)&quot;</JsxCoreToolCommand>
    <!-- Absolute: an Import resolves a relative path against this file, not the project. -->
    <JsxCoreGeneratedProps>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(JsxCoreWorkingDirectory)JsxCore.g.props'))</JsxCoreGeneratedProps>
  </PropertyGroup>

  <!--
    Written by the analysis step during restore and imported on the next evaluation, which is what
    lets an IDE show the packages: a project tree is built from the evaluated project without
    running targets, so items that only exist inside a target are invisible to it. NuGet does the
    same thing for restore, and this inherits the same behaviour, that the tree reflects the last
    restore rather than an unsaved edit.
  -->
  <Import Project="$(JsxCoreGeneratedProps)" Condition="Exists('$(JsxCoreGeneratedProps)')" />

  <!--
    Runs the tool and reads its answers back.

    The generated file is both an import for the next evaluation, which is what an IDE reads, and
    the source of truth for this build, which is read back with XmlPeek. It cannot simply be
    imported and used immediately: an Import is resolved during evaluation, long before any target
    runs, and NuGet deliberately does not import a package's build assets during restore, so there
    is no earlier point at which this could have happened.
  -->
  <Target Name="JsxCoreAnalyse" Condition="'$(_JsxCoreAnalysed)' != 'true'">
    <Warning Condition="!Exists('$(JsxCoreToolPath)')"
             Code="JSX0006"
             Text="JsxCore could not find its build tool at '$(JsxCoreToolPath)'. Views will not be compiled at build time. Set JsxCoreToolPath if you have relocated it." />

    <Exec Condition="Exists('$(JsxCoreToolPath)')"
          Command="$(JsxCoreToolCommand) analyse --project-dir &quot;$(MSBuildProjectDirectory)&quot; --output &quot;$(JsxCoreGeneratedProps)&quot; --search-paths &quot;@(JsxCoreSearchPath)&quot;"
          ContinueOnError="true"
          StandardOutputImportance="low" />

    <PropertyGroup>
      <_JsxCoreAnalysed>true</_JsxCoreAnalysed>
    </PropertyGroup>

    <XmlPeek Condition="Exists('$(JsxCoreGeneratedProps)')" XmlInputPath="$(JsxCoreGeneratedProps)"
             Query="/Project/PropertyGroup/JsxCoreResolvedCompilerPath/text()">
      <Output TaskParameter="Result" PropertyName="JsxCoreResolvedCompilerPath" />
    </XmlPeek>

    <!-- Only when the project has not named one itself, which is how a solution shares a manifest. -->
    <XmlPeek Condition="Exists('$(JsxCoreGeneratedProps)') And '$(JsxCoreManifestDirectory)' == ''"
             XmlInputPath="$(JsxCoreGeneratedProps)"
             Query="/Project/PropertyGroup/JsxCoreManifestDirectory/text()">
      <Output TaskParameter="Result" PropertyName="JsxCoreManifestDirectory" />
    </XmlPeek>

    <XmlPeek Condition="Exists('$(JsxCoreGeneratedProps)')" XmlInputPath="$(JsxCoreGeneratedProps)"
             Query="/Project/PropertyGroup/JsxCoreNodeModulesRoot/text()">
      <Output TaskParameter="Result" PropertyName="JsxCoreNodeModulesRoot" />
    </XmlPeek>

    <XmlPeek Condition="Exists('$(JsxCoreGeneratedProps)')" XmlInputPath="$(JsxCoreGeneratedProps)"
             Query="/Project/ItemGroup/JsxCoreNpmDependency/@Include">
      <Output TaskParameter="Result" ItemName="JsxCoreDependencyName" />
    </XmlPeek>

    <XmlPeek Condition="Exists('$(JsxCoreGeneratedProps)')" XmlInputPath="$(JsxCoreGeneratedProps)"
             Query="/Project/ItemGroup/JsxCoreNpmDevDependency/@Include">
      <Output TaskParameter="Result" ItemName="JsxCoreDevDependencyName" />
    </XmlPeek>

    <!-- The declared runtime dependencies plus everything they depend on, which is what publishing
         has to carry: resolving a package and then failing on its own import is worse than not
         having it. -->
    <XmlPeek Condition="Exists('$(JsxCoreGeneratedProps)')" XmlInputPath="$(JsxCoreGeneratedProps)"
             Query="/Project/ItemGroup/JsxCoreNpmRuntimePackage/@Include">
      <Output TaskParameter="Result" ItemName="JsxCoreRuntimePackageName" />
    </XmlPeek>
  </Target>

  <Target Name="JsxCoreLocateCompiler" DependsOnTargets="JsxCoreAnalyse;JsxCoreLocateManifest">
    <PropertyGroup>
      <JsxCoreCompilerPath Condition="'$(JsxCoreCompilerPath)' == ''">$(JsxCoreResolvedCompilerPath)</JsxCoreCompilerPath>
      <_JsxCoreNodeModules Condition="'$(JsxCoreNodeModulesRoot)' != ''">$(JsxCoreNodeModulesRoot)/</_JsxCoreNodeModules>
    </PropertyGroup>
  </Target>

  <!--
    Declared outside the target on purpose: MSBuild evaluates a target's Inputs before running it,
    so an item group defined inside the target would still be empty and the target would be skipped
    as having no inputs.
  -->
  <ItemGroup>
    <JsxCoreViewFile Include="$(JsxCoreViewsDirectory)/**/*.tsx;$(JsxCoreViewsDirectory)/**/*.jsx;$(JsxCoreViewsDirectory)/**/*.ts;$(JsxCoreViewsDirectory)/**/*.js"
                     Exclude="$(JsxCoreViewsDirectory)/**/node_modules/**/*" />
  </ItemGroup>

  <!--
    npm packages the views import come from package.json, installed the ordinary way:

        npm install marked

    package.json is the record, not the project file. The two kinds mean what they mean to npm:

      dependencies      needed to render. Resolved on the server, served to the browser, and copied
                        into the publish output.
      devDependencies   needed to build. The TypeScript compiler lives here. Never published, and
                        never served to a browser.

    Parsed during evaluation rather than in a target, because an IDE builds its project tree from the
    evaluated project without running targets, and the tree is one of the things this feeds.

    Values in these two blocks are flat strings, so matching to the first closing brace is enough to
    isolate each one. MSBuild escapes separators in property function results, hence the unescape
    before the names become items.
  -->
  <!--
    The framework, stamped onto the application's own assembly.

    The build knows which framework is in play; the application, running later, does not, and it
    needs the same answer to serve the right runtime files. An assembly attribute is the one channel
    that always travels with the code: it survives publishing, precompiled output and a content root
    somewhere else entirely, with no file to find and nothing to keep in step.

    AssemblyMetadata rather than a JsxCore type, so the attribute needs no reference to JsxCore and
    a project that never touches the property still carries the default.
  -->
  <ItemGroup Condition="'$(GenerateAssemblyInfo)' != 'false'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JsxCoreFramework</_Parameter1>
      <_Parameter2 Condition="'$(JsxCoreFramework)' != ''">$(JsxCoreFramework)</_Parameter2>
      <_Parameter2 Condition="'$(JsxCoreFramework)' == ''">preact</_Parameter2>
    </AssemblyAttribute>

    <!-- Travels for the same reason: the project file decides, the application has to obey. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JsxCoreMinify</_Parameter1>
      <_Parameter2>$(JsxCoreMinify)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JsxCoreCompressAssets</_Parameter1>
      <_Parameter2>$(JsxCoreCompressAssets)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JsxCorePrecompiled</_Parameter1>
      <_Parameter2>$(JsxCorePrecompiled)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Search paths handed to the tool, so an application whose content root sits away from its npm
    project can still be analysed.
  -->
  <ItemGroup>
    <JsxCoreSearchPath Include="$(JsxCoreAdditionalSearchPaths.TrimEnd('\').TrimEnd('/'))" Condition="'$(JsxCoreAdditionalSearchPaths)' != ''" />
  </ItemGroup>

  <!--
    Show the installed packages in the IDE's project tree.

    A package name is not a file, and an item whose Include is not a path is drawn as a missing file,
    which is why those items stay hidden. Instead each package is surfaced through the one thing
    about it that is a real file: its installed manifest, linked into a virtual folder.

    That folder shadows package.json itself, so the manifest reads as the root of what it declares:

        package.json/
            package.json
            dependencies/
                marked/package.json
            devDependencies/
                typescript/package.json

    The manifest is relocated into the folder rather than left beside it, so there is one node for
    the subject rather than a file and a folder of the same name sitting next to each other. Where
    the two groups appear relative to the manifest inside the folder is the IDE's own sorting, which
    a project file cannot influence.

    Exists() does the filtering, so a package that is declared but not installed contributes nothing
    rather than a broken entry.

    Set <JsxCoreShowNpmPackagesInIde>false</JsxCoreShowNpmPackagesInIde> to leave the tree alone.
  -->
  <PropertyGroup>
    <JsxCoreShowNpmPackagesInIde Condition="'$(JsxCoreShowNpmPackagesInIde)' == ''">true</JsxCoreShowNpmPackagesInIde>
    <JsxCoreIdePackageFolder Condition="'$(JsxCoreIdePackageFolder)' == ''">package.json</JsxCoreIdePackageFolder>
  </PropertyGroup>

  <ItemGroup Condition="'$(JsxCoreShowNpmPackagesInIde)' == 'true'">
    <!--
      The manifest and its lock file. Both are already items from the SDK's glob, so they are
      updated in place. Which glob depends on the SDK: the web SDK classifies .json as Content,
      others leave it as None. An Update that matches nothing costs nothing, so both are stated,
      as are the lock file names npm can produce.

      TargetPath is pinned because Link is what publish derives an output path from when nothing
      else says otherwise, and moving these in the tree must not move them in the output. The
      manifest is read at run time to tell dependencies from devDependencies, so it has to stay
      where it lands today.
    -->
    <Content Update="package.json;package-lock.json;npm-shrinkwrap.json">
      <Link>$(JsxCoreIdePackageFolder)\%(Filename)%(Extension)</Link>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
      <Visible>true</Visible>
    </Content>

    <None Update="package.json;package-lock.json;npm-shrinkwrap.json">
      <Link>$(JsxCoreIdePackageFolder)\%(Filename)%(Extension)</Link>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
      <Visible>true</Visible>
    </None>

    <!--
      Each installed package, shown through its own manifest. Which packages exist, where they are
      and how they are labelled were all decided by the tool, so nothing is derived here.
    -->
    <None Include="@(JsxCoreNpmDependency->WithMetadataValue('Installed','true')->'%(InstalledManifest)')">
      <Link>$(JsxCoreIdePackageFolder)\dependencies\%(PackageLabel)\package.json</Link>
      <Visible>true</Visible>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>false</Pack>
    </None>

    <None Include="@(JsxCoreNpmDevDependency->WithMetadataValue('Installed','true')->'%(InstalledManifest)')">
      <Link>$(JsxCoreIdePackageFolder)\devDependencies\%(PackageLabel)\package.json</Link>
      <Visible>true</Visible>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>false</Pack>
    </None>
  </ItemGroup>

  <Target Name="JsxCoreLocateManifest" DependsOnTargets="JsxCoreAnalyse">
    <PropertyGroup>
      <_JsxCoreManifestDir Condition="'$(JsxCoreManifestDirectory)' != ''">$(JsxCoreManifestDirectory)/</_JsxCoreManifestDir>
      <_JsxCoreManifestDir Condition="'$(_JsxCoreManifestDir)' == ''">$(MSBuildProjectDirectory)/</_JsxCoreManifestDir>
    </PropertyGroup>
  </Target>

  <!--
    Makes node_modules match package.json before anything tries to read it.

    Every declared package is checked, not just the compiler. A dependency that is listed but not
    installed is the cause of the worst kind of failure here: the build succeeds, because tsc only
    resolves types, and the view then fails to render at run time with an error about a module,
    which reads as a JsxCore fault rather than a missing install.

    Which package manager does the work is decided by the tool, not here. npm is the only one today
    and is used when it is on PATH. That is the seam a native restore, needing no Node installed,
    would arrive through.

    Set <JsxCoreAutoInstallDependencies>false</JsxCoreAutoInstallDependencies> to manage packages
    yourself, and JsxCore will report what is missing rather than install it.
  -->
  <Target Name="JsxCoreEnsureDependencies"
          DependsOnTargets="JsxCoreAnalyse;JsxCoreLocateManifest"
          Condition="Exists('$(MSBuildProjectDirectory)/$(JsxCoreViewsDirectory)')">

    <Exec Condition="Exists('$(JsxCoreToolPath)')"
          Command="$(JsxCoreToolCommand) provision --project-dir &quot;$(MSBuildProjectDirectory)&quot; --manifest-dir &quot;$(_JsxCoreManifestDir)&quot; --framework &quot;$(JsxCoreFramework)&quot; --auto-install &quot;$(JsxCoreAutoInstallDependencies)&quot; --npm-path &quot;$(JsxCoreNpm)&quot; --package-manager &quot;$(JsxCorePackageManager)&quot; --minify &quot;$(JsxCoreMinify)&quot; --assembly &quot;$(TargetPath)&quot;"
          ContinueOnError="true"
          IgnoreExitCode="true"
          StandardOutputImportance="high"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_JsxCoreRestoreExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_JsxCoreRestoreOutput" />
    </Exec>

    <Error Condition="'$(_JsxCoreRestoreExit)' == '4'"
           Code="JSX0005"
           Text="@(_JsxCoreRestoreOutput, ' ')" />


    <Error Condition="'$(_JsxCoreRestoreExit)' == '6'"
           Code="JSX0007"
           Text="@(_JsxCoreRestoreOutput, ' ')" />

    <Warning Condition="'$(_JsxCoreRestoreExit)' == '3' Or '$(_JsxCoreRestoreExit)' == '5'"
             Code="JSX0004"
             Text="@(_JsxCoreRestoreOutput, ' ')" />

    <!--
      Anything installed above did not exist when the project was analysed, so the answers are
      stale. This is the first build of a clean checkout: the compiler is fetched here and would
      otherwise not be found until the next build.
    -->
    <Exec Condition="'$(_JsxCoreRestoreExit)' == '0' And Exists('$(JsxCoreToolPath)')"
          Command="$(JsxCoreToolCommand) analyse --project-dir &quot;$(MSBuildProjectDirectory)&quot; --output &quot;$(JsxCoreGeneratedProps)&quot; --search-paths &quot;@(JsxCoreSearchPath)&quot;"
          ContinueOnError="true"
          StandardOutputImportance="low" />

    <XmlPeek Condition="Exists('$(JsxCoreGeneratedProps)')"
             XmlInputPath="$(JsxCoreGeneratedProps)"
             Query="/Project/PropertyGroup/JsxCoreResolvedCompilerPath/text()">
      <Output TaskParameter="Result" PropertyName="JsxCoreResolvedCompilerPath" />
    </XmlPeek>

    <PropertyGroup>
      <JsxCoreCompilerPath Condition="'$(JsxCoreCompilerPath)' == ''">$(JsxCoreResolvedCompilerPath)</JsxCoreCompilerPath>
    </PropertyGroup>
  </Target>

  <!--
    The assembly is an input alongside the views because declarations for .NET model types are
    generated from it. Changing a model with no view touched still has to recompile, or views would
    keep type checking against the shape the models used to have.
  -->
  <Target Name="JsxCoreCompileViews"
          AfterTargets="Build"
          DependsOnTargets="JsxCoreLocateCompiler;JsxCoreEnsureDependencies"
          Condition="'$(JsxCoreCompileOnBuild)' == 'true' And Exists('$(MSBuildProjectDirectory)/$(JsxCoreViewsDirectory)')"
          Inputs="@(JsxCoreViewFile);$(TargetPath)"
          Outputs="$(JsxCoreWorkingDirectory)build.stamp">

    <Warning Condition="'$(JsxCoreCompilerPath)' == ''"
             Code="JSX0001"
             Text="JsxCore could not find the TypeScript compiler and could not install it, so views were not compiled at build time. Check network access to the npm registry, or install typescript@^7 as a dev dependency yourself. The view engine will compile views at startup instead, which requires the toolchain to be present on the machine that runs the application." />

    <CallTarget Targets="JsxCoreRunCompiler" Condition="'$(JsxCoreCompilerPath)' != ''" />
  </Target>

  <!--
    Declarations for .NET model types are generated from the assembly the build just produced, by
    loading it for inspection only. The application's own entry point never runs.

    It has to happen before the configuration is written, because whether the compiler is pointed
    at real declarations or at the ambient stand-in depends on whether these exist.

    Rolled forward to the newest installed runtime rather than the tool's own, because the tool
    targets net8.0 and has to be able to load an assembly built for a later one.
  -->
  <Target Name="JsxCoreGenerateModelTypes"
          Condition="'$(JsxCoreGenerateModelTypes)' != 'false' And Exists('$(JsxCoreToolPath)') And Exists('$(TargetPath)')"
          Inputs="$(TargetPath)"
          Outputs="$(JsxCoreWorkingDirectory)modeltypes.stamp">
    <Exec Command="dotnet exec --roll-forward LatestMajor &quot;$(JsxCoreToolPath)&quot; types --project-dir &quot;$(MSBuildProjectDirectory)&quot; --views &quot;$(_JsxCoreViewsArg)&quot; --working &quot;$(_JsxCoreWorkingArg)&quot; --assembly &quot;$(TargetPath)&quot;"
          ContinueOnError="true"
          StandardOutputImportance="normal" />

    <!-- Stamped whatever the outcome: a model set that produced nothing should not be retried on
         every build, and the assembly changing is what makes it worth trying again. -->
    <Touch Files="$(JsxCoreWorkingDirectory)modeltypes.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="JsxCoreRunCompiler" DependsOnTargets="JsxCoreGenerateModelTypes;JsxCoreWriteConfig">
    <Exec Command="&quot;$(JsxCoreCompilerPath)&quot; --project &quot;$(JsxCoreWorkingDirectory)tsconfig.json&quot; --pretty false"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true"
          StandardOutputImportance="high"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="JsxCoreExitCode" />
    </Exec>

    <Error Condition="'$(JsxCoreExitCode)' != '0' And '$(JsxCoreTypeChecking)' == 'error'"
           Code="JSX0002"
           Text="JsxCore: TypeScript reported errors in your views. See the output above. Set &lt;JsxCoreTypeChecking&gt;warn&lt;/JsxCoreTypeChecking&gt; to downgrade this to a warning." />

    <Warning Condition="'$(JsxCoreExitCode)' != '0' And '$(JsxCoreTypeChecking)' != 'error'"
             Code="JSX0003"
             Text="JsxCore: TypeScript reported errors in your views. See the output above." />

    <!--
      After the compiler, before anything is published or hashed. Views compiled here are what a
      PrecompiledOnly application serves, and nothing recompiles them later, so if they are not
      minified now they never will be.
    -->
    <Exec Condition="'$(JsxCoreMinify)' == 'true'"
          Command="$(JsxCoreToolCommand) minify --project-dir &quot;$(MSBuildProjectDirectory)&quot; --working &quot;$(_JsxCoreWorkingArg)&quot; --esbuild &quot;$(JsxCoreMinifierPath)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true"
          StandardOutputImportance="high" />

    <Touch Files="$(JsxCoreWorkingDirectory)build.stamp" AlwaysCreate="true" />
  </Target>

  <!--
    The compiler configuration is written by the tool, which calls the same code the view engine
    calls at run time, so a build-time compilation and a startup compilation cannot disagree about
    compiler settings. This used to be assembled here by loading the base configuration as text,
    trimming its last two closing braces and concatenating fragments onto the end.

    The editor configuration beside the views is written by the same call, and only while it still
    carries JsxCore's marker, so a hand-edited one is left alone.
  -->
  <Target Name="JsxCoreWriteConfig" DependsOnTargets="JsxCoreLocateCompiler">
    <Exec Command="$(JsxCoreToolCommand) tsconfig --project-dir &quot;$(MSBuildProjectDirectory)&quot; --views &quot;$(_JsxCoreViewsArg)&quot; --working &quot;$(_JsxCoreWorkingArg)&quot; --framework &quot;$(JsxCoreFramework)&quot; --type-checking &quot;$(JsxCoreTypeChecking)&quot; --editor-config &quot;$(JsxCoreGenerateEditorTsConfig)&quot; --search-paths &quot;@(JsxCoreSearchPath)&quot;"
          StandardOutputImportance="low" />
  </Target>

  <!--
    Carry the compiled views into the publish output, along with the Preact ES modules if they are
    installed.

    Preact matters because the view engine stages it out of node_modules at startup. Without this,
    an application published with PrecompiledOnly would start on a server that has no npm packages
    and then fail to render, which is exactly the deployment this feature exists to support. Only
    the .mjs files and manifests are taken, so this costs a few tens of kilobytes rather than the
    whole package.
  -->
  <!--
    Minify the packages copied into the publish output.

    The application minifies npm assets as it serves them, which covers running locally, but esbuild
    is a development dependency and is deliberately not published: on a server there is nothing to
    minify with, so a published application would serve packages exactly as npm wrote them. Since
    packages are most of what a browser downloads, that is the whole feature missing from the one
    deployment it matters in.

    Done on the copies in the publish output, never in anyone's node_modules, and with each file
    left the kind of module it already is — forcing ESM onto a CommonJS package cannot convert its
    require calls, and JsxCore wraps those itself when serving.
  -->
  <Target Name="JsxCoreMinifyPublishedPackages"
          AfterTargets="Publish"
          DependsOnTargets="JsxCoreLocateCompiler"
          Condition="'$(JsxCoreMinify)' == 'true' And Exists('$(PublishDir)node_modules')">
    <Exec Command="$(JsxCoreToolCommand) minify --project-dir &quot;$(MSBuildProjectDirectory)&quot; --directory &quot;$(PublishDir)node_modules&quot; --esbuild &quot;$(JsxCoreMinifierPath)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true"
          StandardOutputImportance="high" />
  </Target>

  <Target Name="JsxCoreIncludeInPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="JsxCoreAnalyse;JsxCoreLocateCompiler;JsxCoreCompileViews"
          Condition="'$(JsxCoreCompileOnBuild)' == 'true'">

    <ItemGroup>
      <_JsxCorePublishFile Include="$(JsxCoreWorkingDirectory)js/**/*" />
      <ResolvedFileToPublish Include="@(_JsxCorePublishFile)">
        <RelativePath>$(JsxCoreWorkingDirectory)js/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>

    <!--
      Published under node_modules/ so the runtime resolves them exactly as it does in development,
      walking up from the content root. No file list to keep in step with the C# side.
    -->
    <ItemGroup Condition="'$(_JsxCoreNodeModules)' != ''">
      <_JsxCorePreactFile Include="$(_JsxCoreNodeModules)preact/**/dist/*.mjs" />
      <_JsxCorePreactFile Include="$(_JsxCoreNodeModules)preact/package.json"
                          Condition="Exists('$(_JsxCoreNodeModules)preact/package.json')" />
      <_JsxCorePreactFile Include="$(_JsxCoreNodeModules)preact-render-to-string/dist/*.mjs" />
      <_JsxCorePreactFile Include="$(_JsxCoreNodeModules)preact-render-to-string/package.json"
                          Condition="Exists('$(_JsxCoreNodeModules)preact-render-to-string/package.json')" />

      <ResolvedFileToPublish Include="@(_JsxCorePreactFile)">
        <RelativePath>node_modules/$([MSBuild]::MakeRelative('$(_JsxCoreNodeModules)', '%(FullPath)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>

    <!--
      Runtime dependencies from package.json. Server rendering reads these from node_modules at run
      time, and the browser is served them from the same place, so they have to reach the published
      output. devDependencies are build-time only and are deliberately absent, which is the same cut
      a production npm ci makes.
    -->
    <ItemGroup Condition="'$(_JsxCoreNodeModules)' != ''">
      <_JsxCoreRuntimePackage Include="@(JsxCoreRuntimePackageName)"
                              Exclude="preact;preact-render-to-string" />

      <!-- Older generated props, from before the closure was recorded. -->
      <_JsxCoreRuntimePackage Condition="'@(JsxCoreRuntimePackageName)' == ''"
                              Include="@(JsxCoreDependencyName)"
                              Exclude="preact;preact-render-to-string" />

      <_JsxCorePackageFile Include="$(_JsxCoreNodeModules)%(_JsxCoreRuntimePackage.Identity)/**/*"
                           Exclude="$(_JsxCoreNodeModules)%(_JsxCoreRuntimePackage.Identity)/**/node_modules/.bin/**/*" />

      <ResolvedFileToPublish Include="@(_JsxCorePackageFile)">
        <RelativePath>node_modules/$([MSBuild]::MakeRelative('$(_JsxCoreNodeModules)', '%(FullPath)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
