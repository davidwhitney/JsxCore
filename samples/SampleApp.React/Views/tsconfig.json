{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmitOnError": false,
    "noEmit": true,
    "paths": {
      "dotnet:rendering": [
        "../obj/JsxCore/runtime/index.d.ts"
      ],
      "dotnet:rendering/head": [
        "../obj/JsxCore/runtime/head.d.ts"
      ],
      "@/*": [
        "./*"
      ],
      "dotnet:*": [
        "../obj/JsxCore/types/*.d.ts"
      ],
      "react": [
        "../node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "../node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react/jsx-dev-runtime": [
        "../node_modules/@types/react/jsx-dev-runtime.d.ts"
      ],
      "react-dom": [
        "../node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/client": [
        "../node_modules/@types/react-dom/client.d.ts"
      ],
      "react-dom/server.browser": [
        "../node_modules/@types/react-dom/server.browser.d.ts"
      ]
    }
  },
  "//": "jsxcore-generated: written by JsxCore so editors can resolve 'dotnet:rendering'. Delete or edit this file freely; JsxCore only overwrites a file that still contains the marker above. Compilation itself uses the config in the intermediate output directory, not this one.",
  "include": [
    "**/*",
    "../obj/JsxCore/types/**/*.d.ts",
    "../obj/JsxCore/jsxcore-assets.d.ts"
  ]
}